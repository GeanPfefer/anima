+"""Inventário textual offline; não executa SQL, Docker ou processos.
+
+Não substitui pg_catalog: renames/drops e aliases public são normalizados somente
+para as formas presentes neste corpus. Corpos vigentes são necessários para
+não auditar uma definição substituída. Locks implícitos são anotados na análise.
+"""
+import re
+from pathlib import Path
+
+
+def statements(text):
+    """Split SQL sem partir strings, comentários ou corpos dollar-quoted."""
+    start = index = 0
+    while index < len(text):
+        if text.startswith('--', index):
+            end = text.find('\n', index)
+            index = len(text) if end < 0 else end + 1
+        elif text.startswith('/*', index):
+            level = 1
+            index += 2
+            while level and index < len(text):
+                if text.startswith('/*', index): level += 1; index += 2
+                elif text.startswith('*/', index): level -= 1; index += 2
+                else: index += 1
+            if level: raise ValueError('unterminated SQL comment')
+        elif text[index] in "'\"":
+            quote = text[index]; index += 1
+            while index < len(text):
+                if text[index] == quote:
+                    index += 1
+                    if index < len(text) and text[index] == quote: index += 1
+                    else: break
+                else: index += 1
+            else: raise ValueError('unterminated SQL string')
+        elif text[index] == '$' and (match := re.match(r'\$\w*\$', text[index:])):
+            tag = match[0]; end = text.find(tag, index + len(tag))
+            if end < 0: raise ValueError('unterminated SQL dollar body')
+            index = end + len(tag)
+        elif text[index] == ';':
+            yield start, text[start:index+1]
+            index += 1; start = index
+        else: index += 1
+    if text[start:].strip(): yield start, text[start:]
+
+
+def uncomment(text):
+    # Used only on statement prefix/signature, never on dollar-quoted body.
+    return re.sub(r'/\*.*?\*/|--[^\n]*', '', text, flags=re.S).strip()
+
+
+def signature(name, args):
+    types = []
+    for arg in re.split(r',\s*(?![^()]*\))', args):
+        tokens = re.split(r'\bDEFAULT\b|=', arg, flags=re.I)[0].strip().split()
+        if tokens:
+            typ = ' '.join(tokens[1:] if len(tokens) > 1 else tokens).lower()
+            types.append(typ.replace('public.', ''))
+    return name.lower() + '(' + ','.join(types) + ')'
+
+
+def definitions(directory):
+    result = {}
+    for path in sorted(Path(directory).glob('*.sql')):
+        text = path.read_text()
+        for offset, raw in statements(text):
+            # Remove only leading comments (not literals/bodies).
+            prefix = raw
+            while True:
+                new = re.sub(r'^\s*(?:--[^\n]*(?:\n|$)|/\*.*?\*/)', '', prefix, count=1, flags=re.S)
+                if new == prefix: break
+                prefix = new
+            match = re.match(r'\s*CREATE\s+(?:OR\s+REPLACE\s+)?FUNCTION\s+([\w.]+)\s*\((.*?)\)\s*(?:(?:--[^\n]*\n|/\*.*?\*/)\s*)*(RETURNS\b.*?)\bAS\s+(\$\w*\$)(.*?)\4\s*;', prefix, re.I|re.S)
+            if match:
+                key = signature(match[1], uncomment(match[2]))
+                result[key] = dict(name=match[1], args=match[2], header=match[3], body=match[5],
+                    definition=match[0], source=path.name,
+                    line=text[:offset + raw.find(match[0])].count('\n')+1)
+                continue
+            if re.match(r'\s*CREATE\s+(?:OR\s+REPLACE\s+)?FUNCTION\b',prefix,re.I):
+                raise ValueError('unsupported function definition in '+path.name)
+            match = re.match(r'\s*ALTER FUNCTION\s+([\w.]+)\s*\((.*?)\)\s+RENAME TO\s+(\w+)',prefix,re.I|re.S)
+            if match:
+                key = signature(match[1],match[2])
+                if key not in result: raise ValueError('rename not inventoried: '+key)
+                value=result.pop(key); value={**value,'name':match[1].rsplit('.',1)[0]+'.'+match[3]}
+                value['definition']=value['definition'].replace(match[1],value['name'],1)
+                result[signature(value['name'],value['args'])]=value
+            match = re.match(r'\s*DROP FUNCTION\s+(?:IF EXISTS\s+)?([\w.]+)\s*\((.*?)\)',prefix,re.I|re.S)
+            if match: result.pop(signature(match[1],match[2]),None)
+    return result
+
+
+def trigger_definitions(directory):
+    result={}
+    for path in sorted(Path(directory).glob('*.sql')):
+        for offset,raw in statements(path.read_text()):
+            sql=uncomment(raw)
+            match=re.match(r'CREATE\s+(?:CONSTRAINT\s+)?TRIGGER\s+(\w+)\b(.*?)\bON\s+([\w.]+)\b(.*?)EXECUTE\s+FUNCTION\s+([\w.]+)\s*\(',sql,re.I|re.S)
+            if match:
+                name,table=match[1],match[3]
+                result[(table,name)]={'name':name,'table':table,'callback':match[5],
+                    'source':path.name,'definition':sql}
+            match=re.match(r'DROP TRIGGER\s+(?:IF EXISTS\s+)?(\w+)\s+ON\s+([\w.]+)',sql,re.I)
+            if match:result.pop((match[2],match[1]),None)
+    return [v for v in result.values() if v['table'].startswith(('public.work_','public.paid_compute_'))]
+
+
+def work_definitions(directory):
+    all_defs=definitions(directory)
+    selected={k for k,v in all_defs.items() if 'work_' in v['name'] or 'paid_compute' in v['name'] or re.search(
+        r'\bwork_(?:items|claims|events|budget|supervision)|work_target:|autonomous_work_budget:|work_reconciliation:',v['definition'])}
+    callbacks={v['callback'] for v in trigger_definitions(directory)}
+    selected|={k for k,v in all_defs.items() if v['name'] in callbacks}
+    # Include private callees (validators/triggers/paid scope boundaries), recursively.
+    changed=True
+    while changed:
+        changed=False
+        calls={n for k in selected for n in re.findall(r'\b((?:public|private)\.\w+)\s*\(',all_defs[k]['body'])}
+        for k,v in all_defs.items():
+            if k not in selected and v['name'] in calls:selected.add(k);changed=True
+    return {k:v for k,v in all_defs.items() if k in selected}
+
+
+def cycles(paths):
+    """Todas as classes de ciclos simples no grafo fornecido, não no PostgreSQL."""
+    edges = {}
+    for path in paths:
+        # Locks já detidos, reentrantes, não criam novas dependências.
+        unique=list(dict.fromkeys(path))
+        for a,b in zip(unique,unique[1:]):edges.setdefault(a,set()).add(b)
+    found=set()
+    def visit(start,node,path):
+        for next_node in edges.get(node,()):
+            if next_node==start and len(path)>1:
+                rotations=[tuple(path[i:]+path[:i]) for i in range(len(path))]
+                found.add(min(rotations))
+            elif next_node not in path:visit(start,next_node,path+[next_node])
+    for node in edges:visit(node,node,[node])
+    return sorted(found)
+
