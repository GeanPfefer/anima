+-- Somente fixtures transacionais descartáveis. Nenhum bypass de trigger/policy.
+-- Incluir routing.inc antes deste arquivo. Não usar como ferramenta do produto.
+CREATE FUNCTION pg_temp.prepare_guarded_attempt(p_item uuid,p_attempt uuid,p_executor text DEFAULT 'local-runner-v1')
+RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
+DECLARE i public.work_items; saved text:=current_setting('request.jwt.claim.sub',true);
+BEGIN
+  SELECT * INTO STRICT i FROM public.work_items WHERE id=p_item;
+  IF i.state<>'approved' THEN RAISE EXCEPTION 'guarded fixture requires approved item'; END IF;
+  PERFORM set_config('request.jwt.claim.sub',i.user_id::text,true);
+  IF NOT EXISTS(SELECT 1 FROM public.work_events e WHERE e.work_item_id=i.id
+     AND e.proposal_version=i.proposal_version AND e.event_type='work_intelligence_classified') THEN
+    PERFORM public.record_work_intelligence_classification(i.id,i.proposal_version,0,
+      '{"schemaVersion":1,"complexity":"bounded","risk":"low","reversibility":"reversible","planClarity":"clear","urgency":"normal","provenance":{"kind":"human_confirmed","classifiedAt":"2026-07-28T12:00:00Z","classifierId":"guarded-fixture"}}'::jsonb);
+  END IF;
+  PERFORM pg_temp.record_test_route(i.id,p_attempt,p_executor);
+  PERFORM set_config('request.jwt.claim.sub',coalesce(saved,''),true);
+EXCEPTION WHEN OTHERS THEN
+  PERFORM set_config('request.jwt.claim.sub',coalesce(saved,''),true); RAISE;
+END $$;
+
+CREATE FUNCTION pg_temp.guarded_history(p_item uuid,p_attempt uuid,p_started timestamptz,
+  p_claim uuid DEFAULT gen_random_uuid(),p_executor text DEFAULT 'local-runner-v1')
+RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
+DECLARE i public.work_items;
+BEGIN
+  -- Cada admissão passa por classificação, routing e budget ATIVOS.
+  PERFORM pg_temp.prepare_guarded_attempt(p_item,p_attempt,p_executor);
+  SELECT * INTO STRICT i FROM public.work_items WHERE id=p_item;
+  INSERT INTO public.work_claims(id,work_item_id,user_id,approved_proposal_version,
+    owner_instance_id,acquired_at,expires_at,attempt_id,target_reference,released_at,release_reason)
+  VALUES(p_claim,i.id,i.user_id,i.proposal_version,'guarded-history',p_started,
+    p_started+interval '5 minutes',p_attempt,btrim(i.intent#>>'{execution_spec,target,reference}'),
+    p_started+interval '1 second','attempt_finished');
+  INSERT INTO public.work_events(work_item_id,event_type,author,proposal_version,payload,created_at)
+  VALUES(i.id,'execution_started','anima',i.proposal_version,
+    jsonb_build_object('schema_version',1,'data',jsonb_build_object('work_item_id',i.id,
+      'approved_proposal_version',i.proposal_version,'attempt_id',p_attempt,'claim_id',p_claim,
+      'executor_id',p_executor,'origin','anima','reason','synthetic_history')),p_started);
+  INSERT INTO public.work_events(work_item_id,event_type,author,proposal_version,payload,created_at)
+  VALUES(i.id,'execution_failed','executor',i.proposal_version,
+    jsonb_build_object('schema_version',1,'data',jsonb_build_object('attempt_id',p_attempt,
+      'retryable',false)),p_started+interval '1 second');
+END $$;
+
+CREATE FUNCTION pg_temp.guarded_claim(p_item uuid,p_claim uuid)
+RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
+DECLARE i public.work_items;
+BEGIN
+  SELECT * INTO STRICT i FROM public.work_items WHERE id=p_item;
+  INSERT INTO public.work_claims(id,work_item_id,user_id,approved_proposal_version,
+    owner_instance_id,acquired_at,expires_at,target_reference)
+  VALUES(p_claim,i.id,i.user_id,i.proposal_version,'guarded-candidate',now(),
+    now()+interval '5 minutes',btrim(i.intent#>>'{execution_spec,target,reference}'));
+END $$;
