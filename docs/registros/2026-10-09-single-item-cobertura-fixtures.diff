+"""Gates offline de contratos/fixtures e modelo finito de interleavings.
+
+Não são parser PL/pgSQL, prova de catálogo, TAP ou execução PostgreSQL.
+"""
+import hashlib
+import json
+import re
+import unittest
+from pathlib import Path
+
+from single_item_lock_audit import cycles, definitions, statements, work_definitions
+from single_item_pgtap_payload import render_suite, SUITES
+
+ROOT = Path(__file__).resolve().parents[2]
+TESTS = ROOT/'supabase/tests'
+
+
+def assertion_hashes(sql):
+    result=[]
+    for _,statement in statements(sql):
+        match=re.search(r'(?m)^SELECT (?:is|isnt|ok|lives_ok|throws_ok)\(',statement)
+        if match:
+            text=statement[match.start():].replace(',"executor_id":"local-runner-v1"','')
+            text=re.sub(r'\s+',' ',text).strip()
+            result.append(hashlib.sha256(text.encode()).hexdigest())
+    return result
+
+
+def deadlocks(a,b):
+    """Enumera todos os interleavings de 2 transações; recursos exclusivos.
+
+    Recursos de FK representam conflito KEY SHARE vs FOR UPDATE para os pares
+    testados. Owners/chaves/linhas são IDs distintos, não classes colapsadas.
+    """
+    paths=(tuple(a),tuple(b));visited=set()
+    def search(positions,held):
+        state=(positions,tuple(sorted(held.items())))
+        if state in visited:return False
+        visited.add(state)
+        if positions==(len(paths[0])+1,len(paths[1])+1):return False
+        choices=[]
+        for side in (0,1):
+            index=positions[side]
+            if index>len(paths[side]):continue
+            if index==len(paths[side]):
+                changes={r:o for r,o in held.items() if o!=side}
+            else:
+                resource=paths[side][index]
+                if resource in held and held[resource]!=side:continue
+                changes={**held,resource:side}
+            next_positions=list(positions);next_positions[side]+=1
+            choices.append((tuple(next_positions),changes))
+        if not choices:return True
+        return any(search(pos,locks) for pos,locks in choices)
+    return search((0,0),{})
+
+
+class LockReview(unittest.TestCase):
