+        contracts=json.loads((TESTS/'fixtures/single_item_assertion_contract.json').read_text())['suites']
+        self.assertEqual(sum(c['count'] for c in contracts.values()),178)
+        for name,contract in contracts.items():
+            with self.subTest(suite=name):
+                actual=assertion_hashes((TESTS/name).read_text())
+                self.assertEqual(len(actual),contract['count'])
+                self.assertEqual(actual,contract['normalizedStatementSha256'])
