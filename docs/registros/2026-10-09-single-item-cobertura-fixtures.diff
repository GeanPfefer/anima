+"""Rendering offline fechado das fixtures reformuladas; nenhum executor SQL."""
+import re
+from pathlib import Path
+
+DIRECTORY = Path(__file__).resolve().parent
+SUITES = frozenset(('work_budget.test.sql','work_budget_local_vs_external.test.sql',
+    'budget_blocked_human_resume.test.sql','work_budget_interruption_resumption.test.sql',
+    'supervisor_reconciliation.test.sql','single_item_work_claim.test.sql'))
+HELPERS = frozenset(('helpers/routing.inc','helpers/guarded_history.inc'))
+
+
+def render_suite(name):
+    if name not in SUITES:
+        raise ValueError('suite outside reviewed fixture corpus')
+    sql=(DIRECTORY/name).read_text()
+    def include(match):
+        name=match[1]
+        if name not in HELPERS:raise ValueError('include outside closed allowlist')
+        path=(DIRECTORY/name).resolve()
+        if not path.is_relative_to(DIRECTORY.resolve()):raise ValueError('helper escaped corpus')
+        return path.read_text()
+    sql=re.sub(r'^\\ir\s+([^\r\n]+)\r?$',include,sql,flags=re.M)
+    if re.search(r'^\\(?:ir|i)\b',sql,re.M):raise ValueError('unexpanded include')
+    if re.search(r'DISABLE\s+TRIGGER|session_replication_role',sql,re.I):
+        raise ValueError('guard bypass in payload')
+    return sql
