+                         'NOT p.proisstrict', 'NOT p.proleakproof', "p.proparallel='u'",
+                         "p.proconfig=ARRAY['search_path=pg_catalog']", 'p.proargnames=ARRAY',
+                         "p.prorettype='jsonb'::regtype", 'p.pronargdefaults=0'):
+            self.assertIn(metadata, sql)
