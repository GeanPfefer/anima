+-- Pré-requisito proposto para NOVO PostgreSQL descartável. NÃO executado.
+-- Sessão postgres; manter separado dos schemas e ledgers do produto/Auth.
+BEGIN;
+CREATE SCHEMA bootstrap_audit AUTHORIZATION postgres;
+REVOKE ALL ON SCHEMA bootstrap_audit FROM PUBLIC;
+CREATE TABLE bootstrap_audit.steps (
+  run_id text NOT NULL CHECK (run_id ~ '^[a-z0-9]{16,40}$'),
+  step_order integer NOT NULL CHECK (step_order > 0),
+  phase text NOT NULL CHECK (length(phase) > 0),
+  name text NOT NULL CHECK (length(name) > 0),
+  role_name text NOT NULL CHECK (role_name IN ('postgres','supabase_admin','supabase_auth_admin')),
+  source_sha256 text NOT NULL CHECK (source_sha256 ~ '^[a-f0-9]{64}$'),
+  body_sha256 text NOT NULL CHECK (body_sha256 ~ '^[a-f0-9]{64}$'),
+  applied_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY (run_id,step_order),
+  UNIQUE (run_id,phase,name)
+);
+REVOKE ALL ON bootstrap_audit.steps FROM PUBLIC,anon,authenticated,service_role,
+  supabase_admin,supabase_auth_admin;
+COMMIT;
