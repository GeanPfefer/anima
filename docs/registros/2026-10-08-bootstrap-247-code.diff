+"""Planejamento offline de bootstrap. Não possui execução SQL, Docker ou rede.
+
+A ordem/roles vêm de uma especificação revisada, nunca de glob implícito.
+O operador futuro deve executar payloads imutáveis e reconciliar o ledger SQL.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def terminate_sql(source):
+    """Scanner conservador: recusa transações/metacomandos e léxico aberto.
+
+    Sem parser PostgreSQL: strings E/backslash são recusadas, não adivinhadas.
+    Comentários e corpos dollar-quoted não são instruções de topo.
+    """
+    text = source.decode('utf-8-sig')
+    if '\x00' in text:
+        raise ValueError('NUL forbidden')
+    i, tokens, last = 0, [], None
+    while i < len(text):
+        if text[i].isspace():
+            i += 1
+            continue
+        if text.startswith('--', i):
+            end = text.find('\n', i)
+            i = len(text) if end < 0 else end + 1
+            continue
+        if text.startswith('/*', i):
+            depth, i = 1, i + 2
+            while i < len(text) and depth:
+                if text.startswith('/*', i):
+                    depth, i = depth + 1, i + 2
+                elif text.startswith('*/', i):
+                    depth, i = depth - 1, i + 2
+                else:
+                    i += 1
+            if depth:
+                raise ValueError('open comment')
+            continue
+        if text[i] == '\\':
+            raise ValueError('psql metacommand forbidden')
+        tag = re.match(r'\$(?:[A-Za-z_][A-Za-z_0-9]*)?\$', text[i:])
+        if tag:
+            end = text.find(tag[0], i + len(tag[0]))
+            if end < 0:
+                raise ValueError('open dollar quote')
+            i, last = end + len(tag[0]), 'body'
+            continue
+        if text[i] in "'\"":
+            quote, i = text[i], i + 1
+            while i < len(text):
+                if text[i] == '\\':
+                    raise ValueError('backslash quoting requires manual review')
+                if text[i] == quote:
+                    if i + 1 < len(text) and text[i+1] == quote:
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                i += 1
+            else:
+                raise ValueError('open quote')
+            last = 'quoted'
+            continue
+        word = re.match(r'[A-Za-z_][A-Za-z_0-9]*', text[i:])
+        if word:
+            tokens.append(word[0].upper())
+            i, last = i + len(word[0]), 'word'
+            continue
+        if text[i] == ';':
+            check_statement(tokens)
+            tokens, last = [], ';'
+        else:
+            last = text[i]
+        i += 1
+    check_statement(tokens)
+    if last is None:
+        raise ValueError('empty SQL')
+    # Newline BEFORE ; prevents a trailing -- comment swallowing the terminator.
+    return (text + ('\n' if last == ';' else '\n;\n')).encode('utf-8')
+
+
+def check_statement(tokens):
+    if not tokens:
+        return
+    if tokens[0] in {'BEGIN', 'COMMIT', 'END', 'ROLLBACK', 'ABORT', 'SAVEPOINT', 'RELEASE'} \
+            or tokens[:2] in (['START', 'TRANSACTION'], ['PREPARE', 'TRANSACTION']) \
+            or tokens[:2] in (['SET', 'ROLE'], ['RESET', 'ROLE']) \
+            or tokens[:3] == ['SET', 'LOCAL', 'ROLE']:
+        raise ValueError('transaction/role control requires manual review')
+    if tokens[:3] == ['CREATE', 'INDEX', 'CONCURRENTLY'] or tokens[0] in {'VACUUM', 'REINDEX'}:
+        raise ValueError('nontransactional SQL requires manual review')
+
+
+def literal(value):
+    return "'" + value.replace("'", "''") + "'"
+
+
+def compose(source, run_id, order, phase, name, role):
+    if not re.fullmatch('[a-z0-9]{16,40}', run_id) or type(order) is not int or order < 1:
+        raise ValueError('run/order invalid')
+    if role not in {'postgres', 'supabase_admin', 'supabase_auth_admin'}:
+        raise ValueError('role not allowlisted')
+    if not phase or not name:
+        raise ValueError('source identity required')
+    body = terminate_sql(source)
+    source_hash, body_hash = digest(source), digest(body)
+    values = ','.join([literal(run_id), str(order), literal(phase), literal(name),
+                       literal(role), literal(source_hash), literal(body_hash)])
+    # Ledger is created by the approved prerequisite, before application steps.
+    # RESET ROLE restores the session login; future executor MUST login postgres.
+    payload = (f'BEGIN;\nSET LOCAL ROLE {role};\n'.encode() + body +
+               (f'RESET ROLE;\nINSERT INTO bootstrap_audit.steps '
+                f'(run_id,step_order,phase,name,role_name,source_sha256,body_sha256) '
+                f'VALUES ({values});\nCOMMIT;\n').encode())
+    return payload, dict(order=order, phase=phase, name=name, role=role,
+                         sourceSha256=source_hash, bodySha256=body_hash,
+                         payloadSha256=digest(payload))
+
+
+def reconcile(plan, database_rows, run_id):
+    """Somente prefixo exato confirmado permite diagnóstico de próximo passo.
+
+    As linhas são fatos coletados futuramente no DB descartável, não status local.
+    Não executa nem autoriza retry. Drift, lacuna/duplicação/row extra recusam.
+    """
+    if not re.fullmatch('[a-z0-9]{16,40}', run_id):
+        raise ValueError('run identity invalid')
+    if len(database_rows) > len(plan):
+        raise ValueError('ledger extra rows')
+    for expected, actual in zip(plan, database_rows):
+        ledger_expected = dict(runId=run_id, **{k: v for k, v in expected.items() if k != 'payloadSha256'})
+        if actual != ledger_expected:
+            raise ValueError('ledger drift or gap')
+    return len(database_rows) + 1
+
+
+def append_event(path, event):
+    with Path(path).open('a', encoding='utf-8') as stream:
+        stream.write(json.dumps(event, sort_keys=True) + '\n')
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def prepare(spec, out):
+    if set(spec) != {'runId', 'steps'} or not spec['steps']:
+        raise ValueError('exact specification required')
+    prepared, identities = [], set()
+    for order, step in enumerate(spec['steps'], 1):
+        if set(step) != {'source', 'phase', 'name', 'role', 'sourceSha256'}:
+            raise ValueError('exact step fields required')
+        identity = (step['phase'], step['name'])
+        if identity in identities:
+            raise ValueError('duplicate step')
+        identities.add(identity)
+        source = Path(step['source']).read_bytes()
+        if digest(source) != step['sourceSha256']:
+            raise ValueError('reviewed source hash mismatch')
+        payload, entry = compose(source, spec['runId'], order,
+                                 step['phase'], step['name'], step['role'])
+        prepared.append((payload, entry))
+    # Validate everything before creating output. Never overwrite a previous run.
+    out = Path(out)
+    out.mkdir(parents=True, exist_ok=False)
+    for payload, entry in prepared:
+        with (out / f"{entry['order']:03}.sql").open('xb') as stream:
+            stream.write(payload)
+            stream.flush()
+            os.fsync(stream.fileno())
+        append_event(out / 'plan.jsonl', dict(runId=spec['runId'], status='prepared', **entry))
+    return [entry for _, entry in prepared]
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('spec')
+    parser.add_argument('output')
+    args = parser.parse_args()
+    specification = json.loads(Path(args.spec).read_text(encoding='utf-8-sig'))
+    prepare(specification, args.output)
+    print('Prepared offline; no SQL/Docker executed; human review required')
