+       '   WHERE work_item_id=i.id OR (user_id=u AND request_id=request_id);')
+NEW = ('SELECT * INTO old FROM public.work_budget_resume_authorizations a\n'
+       "   WHERE a.work_item_id=i.id OR (a.user_id=u AND a.request_id=(p_authorization->>'requestId')::uuid);")
+
+
+def source_body():
+    return re.search(r'CREATE FUNCTION public.authorize_work_resume\([\s\S]*?AS \$\$(.*?)\$\$;',
+                     BASE.read_text(), re.S)[1]
+
+
+def text_contract(body):
+    """Modelo offline limitado aos hashes/replace e ordem dos guards da migration.
+
+    A suíte verifica a ligação ao SQL real; não interpreta nem prova o catálogo PG.
+    """
+    sql = PATCH.read_text()
+    hashes = dict(re.findall(r"(old|corrected)_hash constant text := '([a-f0-9]{64})'", sql))
+    value = hashlib.sha256(body.encode()).hexdigest()
+    if value not in hashes.values():
+        raise ValueError('definition_unknown')
+    if value == hashes['corrected']:
+        return body, 0
+    fixed = body.replace(OLD, NEW)
+    if hashlib.sha256(fixed.encode()).hexdigest() != hashes['corrected']:
+        raise ValueError('postcondition_failed')
+    return fixed, 1
