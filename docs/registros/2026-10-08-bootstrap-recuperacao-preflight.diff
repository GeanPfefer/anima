+"""Ledger host append-only; independente de Docker e PostgreSQL."""
+import datetime
+import json
+import os
+
+
+def append_event(record, data, clock=None):
+    utc = clock() if clock else datetime.datetime.now(datetime.timezone.utc).isoformat()
+    item = dict(data, utc=utc)
+    with (record / 'events.jsonl').open('a', encoding='utf8') as stream:
+        stream.write(json.dumps(item, sort_keys=True) + '\n')
+        stream.flush()
+        os.fsync(stream.fileno())
