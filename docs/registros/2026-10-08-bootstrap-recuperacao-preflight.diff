@@ -0,0 +1,86 @@
+"""Contrato de recuperação offline; não executa Docker/SQL."""
+import copy
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from single_item_proof_preflight import validate, PINNED_IMAGE_LABELS
+import single_item_concurrency_test as existing
+from bootstrap_event_log import append_event
+
+
+class RecoveryBoundary(unittest.TestCase):
+    def sample(self):
+        manifest, metadata = existing.ProofBoundaryTest().environment()
+        image = {'Id': manifest['imageId'], 'Config': {'Labels': dict(PINNED_IMAGE_LABELS)}}
+        metadata['Config']['Labels'].update(PINNED_IMAGE_LABELS)
+        metadata['Config']['Volumes'] = None
+        return manifest, metadata, image
+
+    def test_exact_inherited_labels_require_exact_image_identity(self):
+        manifest, metadata, image = self.sample()
+        self.assertEqual(validate(manifest, metadata, image), manifest['containerId'])
+        with self.assertRaises(ValueError):
+            validate(manifest, metadata)
+        image['Id'] = 'sha256:' + 'f' * 64
+        with self.assertRaises(ValueError):
+            validate(manifest, metadata, image)
+
+    def test_unknown_missing_or_changed_labels_refused(self):
+        manifest, metadata, image = self.sample()
+        for target in ('container', 'image'):
+            labels = metadata['Config']['Labels'] if target == 'container' else image['Config']['Labels']
+            for key in list(labels) + ['arbitrary']:
+                for mutation in ('remove', 'change'):
+                    with self.subTest(target=target, key=key, mutation=mutation):
+                        c, i = copy.deepcopy(metadata), copy.deepcopy(image)
+                        changed = c['Config']['Labels'] if target == 'container' else i['Config']['Labels']
+                        if mutation == 'remove':
+                            changed.pop(key, None)
+                            if key == 'arbitrary':
+                                continue
+                        else:
+                            changed[key] = 'unexpected'
+                        with self.assertRaises(ValueError):
+                            validate(manifest, c, i)
+
+    def test_created_contract_and_running_mounts_are_distinct(self):
+        manifest, metadata, image = self.sample()
+        metadata.update(State={'Status': 'created', 'Running': False, 'Pid': 0,
+                               'StartedAt': '0001-01-01T00:00:00Z'}, RestartCount=0)
+        metadata['HostConfig']['Tmpfs'] = {m['Destination']: 'rw' for m in metadata['Mounts']}
+        metadata['Mounts'] = []
+        self.assertEqual(validate(manifest, metadata, image, created=True), manifest['containerId'])
+        with self.assertRaises(ValueError):
+            validate(manifest, metadata, image)
+        for key, value in [('Status', 'exited'), ('Running', True), ('Pid', 1),
+                           ('StartedAt', '2026-10-08T22:00:00Z')]:
+            c = copy.deepcopy(metadata); c['State'][key] = value
+            with self.assertRaises(ValueError):
+                validate(manifest, c, image, created=True)
+        for mutation in ('restart', 'mount', 'tmpfs'):
+            c = copy.deepcopy(metadata)
+            if mutation == 'restart':
+                c['RestartCount'] = 1
+            elif mutation == 'mount':
+                c['Mounts'] = [{'Type': 'volume', 'Destination': '/var/lib/postgresql/data'}]
+            else:
+                c['HostConfig']['Tmpfs']['/shared'] = 'rw'
+            with self.assertRaises(ValueError):
+                validate(manifest, c, image, created=True)
+
+    def test_executor_event_reserved_timestamp_and_first_failure(self):
+        with tempfile.TemporaryDirectory() as folder:
+            record = Path(folder)
+            failure = {'utc': 'source-time', 'status': 'failed-stop', 'error': 'first failure'}
+            append_event(record, failure, clock=lambda: 'host-time')
+            append_event(record, {'utc': 'other-time', 'status': 'diagnostic'}, clock=lambda: 'host-time')
+            rows = [json.loads(x) for x in (Path(folder) / 'events.jsonl').read_text().splitlines()]
+            self.assertEqual(rows[0], dict(failure, utc='host-time'))
+            self.assertEqual(rows[0]['error'], 'first failure')
+            self.assertEqual(failure['utc'], 'source-time')
+            self.assertEqual(len(rows), 2)
+
+
+if __name__ == '__main__':
+    unittest.main()
