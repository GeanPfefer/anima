+def decode_query_result(output):
+    """psql -At emits native booleans as t/f; all other results must be JSON.
+
+    No truthiness fallback: empty, multi-row or malformed output fails closed.
+    """
+    value = output.strip()
+    if value == 't':
+        return True
+    if value == 'f':
+        return False
+    return json.loads(value)
