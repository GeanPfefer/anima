+    def test_psql_native_booleans_and_json(self):
+        for raw, value in [('t', True), ('f', False), ('true', True), ('false', False),
+                           ('0', 0), ('[]', []), ('null', None), (' {"a":1}\n', {'a': 1})]:
+            with self.subTest(raw=raw):
+                self.assertEqual(decode_query_result(raw), value)
+        for raw in ('', 'yes', 't\nf', '1\n2', 'NOTICE: x\nt'):
+            with self.subTest(raw=raw), self.assertRaises(ValueError):
+                decode_query_result(raw)
+
+    def test_environment_query_decodes_false_without_truthiness(self):
+        env = object.__new__(Environment)
+        env.base, env.env = [], {}
+        with patch.object(env, 'check'), patch('single_item_concurrency.subprocess.run',
+                return_value=subprocess.CompletedProcess([], 0, 'f\n', '')):
+            self.assertIs(env.query('SELECT EXISTS(...);'), False)
+        with patch.object(env, 'check'), patch('single_item_concurrency.subprocess.run',
+                return_value=subprocess.CompletedProcess([], 3, 't\n', '42501 refused')):
+            with self.assertRaisesRegex(RuntimeError, '42501'):
+                env.query('SELECT EXISTS(...);')
+
+    def cleanup_session(self, failing_stream, error, running=False):
+        from unittest.mock import Mock
+        session = object.__new__(Session)
+        session.process = Mock()
+        session.process.poll.return_value = None if running else 3
+        session.process.stdin, session.process.stdout, session.process.stderr = Mock(), Mock(), Mock()
+        getattr(session.process, failing_stream).close.side_effect = error
+        return session
+
+    def test_cleanup_ignores_only_exited_stdin_epipe(self):
+        session = self.cleanup_session('stdin', BrokenPipeError(errno.EPIPE, 'peer closed'))
+        session.close()
+        for name in ('stdin', 'stdout', 'stderr'):
+            getattr(session.process, name).close.assert_called_once()
+        session.process.terminate.assert_not_called()
+
+    def test_cleanup_other_stream_errors_remain_failure_and_all_close(self):
+        for name, error in [('stdout', BrokenPipeError(errno.EPIPE, 'unexpected')),
+                            ('stdin', OSError(errno.EIO, 'disk failure'))]:
+            session = self.cleanup_session(name, error)
+            with self.subTest(name=name), self.assertRaisesRegex(RuntimeError, 'client cleanup failed'):
+                session.close()
+            for stream in ('stdin', 'stdout', 'stderr'):
+                getattr(session.process, stream).close.assert_called_once()
+
+    def test_real_buffered_stdin_epipe_after_process_exit(self):
+        session = Session([sys.executable, '-u', '-c',
+                           "import sys; print('READY=1'); sys.exit(3)"], dict(os.environ))
+        self.assertEqual(session.marker('READY='), '1')
+        code, _ = session.finish()
+        self.assertEqual(code, 3)
+        # Reproduce buffered TextIOWrapper flush on close after peer exit.
+        session.process.stdin.write('pending input')
+        session.close()
+        self.assertTrue(session.process.stdin.closed)
+        self.assertTrue(session.process.stdout.closed)
+        self.assertTrue(session.process.stderr.closed)
+
