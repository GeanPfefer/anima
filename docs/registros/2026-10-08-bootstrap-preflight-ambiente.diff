+"""Env/isolamento determinísticos; não acessa Docker, PostgreSQL ou rede."""
+import unittest
+from single_item_proof_preflight import (PINNED_IMAGE_ENV, validate_image_environment,
+                                         validate_container_environment, validate)
+import single_item_concurrency_test as existing_proofs
+
+
+def entries(values):
+    return [f'{key}={value}' for key, value in values.items()]
+
+
+class EnvironmentBoundary(unittest.TestCase):
+    def environment(self):
+        return existing_proofs.ProofBoundaryTest().environment()
+
+    def test_exact_official_defaults_and_explicit_container_identity(self):
+        self.assertEqual(validate_image_environment(entries(PINNED_IMAGE_ENV)), PINNED_IMAGE_ENV)
+        manifest, metadata = self.environment()
+        self.assertEqual(validate(manifest, metadata), manifest['containerId'])
+        self.assertEqual(dict(e.split('=', 1) for e in metadata['Config']['Env'])['POSTGRES_USER'], 'postgres')
+
+    def test_every_unknown_name_and_wrong_known_value_refused(self):
+        for key in PINNED_IMAGE_ENV:
+            bad = dict(PINNED_IMAGE_ENV, **{key: 'unexpected'})
+            with self.subTest(key=key), self.assertRaises(ValueError):
+                validate_image_environment(entries(bad))
+        for key in ('PGHOST', 'PGPORT', 'PGSERVICE', 'PGSERVICEFILE', 'PGPASSFILE', 'PGPASSWORD',
+                    'POSTGRES_PASSWORD', 'SUPABASE_SERVICE_ROLE_KEY', 'LD_PRELOAD', 'BASH_ENV', 'SSL_CERT_FILE'):
+            with self.subTest(key=key), self.assertRaises(ValueError):
+                validate_image_environment(entries(dict(PINNED_IMAGE_ENV, **{key: 'unexpected'})))
+
+    def test_remote_tcp_resident_port_and_alternate_socket_refused(self):
+        manifest, metadata = self.environment()
+        env = dict(e.split('=', 1) for e in metadata['Config']['Env'])
+        for host in ('remote.example', '100.68.239.78', 'localhost', '127.0.0.1',
+                     '127.0.0.1:54322', '::1', '/resident/socket', '/var/run/postgresql/', ''):
+            with self.subTest(host=host), self.assertRaises(ValueError):
+                validate_container_environment(entries(dict(env, POSTGRES_HOST=host)), manifest)
+
+    def test_container_password_tokens_and_destination_env_refused(self):
+        manifest, metadata = self.environment()
+        for extra in ('PGHOST=/var/run/postgresql', 'PGPORT=5432', 'PGUSER=postgres',
+                      'PGDATABASE=postgres', 'PGPASSWORD=secret', 'POSTGRES_PASSWORD=secret',
+                      'SUPABASE_JWT_SECRET=secret', 'ANIMA_JWT=secret', 'PGOPTIONS=-c role=postgres'):
+            with self.subTest(extra=extra), self.assertRaises(ValueError):
+                validate_container_environment(metadata['Config']['Env'] + [extra], manifest)
+
+    def test_initialization_defaults_cannot_remain_in_proof_container(self):
+        manifest, metadata = self.environment()
+        env = dict(e.split('=', 1) for e in metadata['Config']['Env'])
+        for overrides in (dict(POSTGRES_DB='postgres'), dict(POSTGRES_USER='supabase_admin'),
+                          dict(PGDATA='/etc/postgresql'), dict(POSTGRES_HOST_AUTH_METHOD='md5')):
+            with self.subTest(overrides=overrides), self.assertRaises(ValueError):
+                validate_container_environment(entries(dict(env, **overrides)), manifest)
+
+    def test_duplicates_missing_and_malformed_refused(self):
+        for candidate in (entries(PINNED_IMAGE_ENV) + ['LANG=en_US.UTF-8'],
+                          entries(PINNED_IMAGE_ENV)[:-1], ['malformed'], ['PATH'], None):
+            with self.subTest(candidate=candidate), self.assertRaises(ValueError):
+                validate_image_environment(candidate)
+
+    def test_shared_mount_network_namespace_and_ports_refused(self):
+        for mutation in ('bind', 'volume', 'network', 'ports', 'pid', 'ipc'):
+            manifest, metadata = self.environment()
+            if mutation == 'bind': metadata['HostConfig']['Binds'] = ['/resident:/proof']
+            if mutation == 'volume': metadata['Mounts'][0]['Type'] = 'volume'
+            if mutation == 'network': metadata['HostConfig']['NetworkMode'] = 'bridge'
+            if mutation == 'ports': metadata['HostConfig']['PortBindings'] = {'5432/tcp': [{'HostPort': '54322'}]}
+            if mutation == 'pid': metadata['HostConfig']['PidMode'] = 'host'
+            if mutation == 'ipc': metadata['HostConfig']['IpcMode'] = 'host'
+            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
+                validate(manifest, metadata)
+
+
+if __name__ == '__main__':
+    unittest.main()
