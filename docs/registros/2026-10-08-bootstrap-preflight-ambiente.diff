+def parse_environment(entries):
+    if not isinstance(entries, list) or any(not isinstance(e, str) or '=' not in e for e in entries):
+        raise ValueError('environment entries invalid')
+    env = dict(entry.split('=', 1) for entry in entries)
+    if len(env) != len(entries):
+        raise ValueError('duplicate environment keys forbidden')
+    return env
+
+
+def validate_image_environment(entries):
+    env = parse_environment(entries)
+    if env != PINNED_IMAGE_ENV:
+        raise ValueError('pinned image environment differs from exact known defaults')
+    return env
+
+
+def expected_container_environment(manifest):
+    validate_manifest(manifest)
+    env = dict(PINNED_IMAGE_ENV)
+    # Initialization defaults must be replaced by the explicit proof identity.
+    # POSTGRES_HOST remains the local UNIX socket, never a TCP destination.
+    env.update(POSTGRES_USER='postgres', POSTGRES_DB=manifest['database'],
+               POSTGRES_HOST_AUTH_METHOD='trust')
+    return env
+
+
+def validate_container_environment(entries, manifest):
+    if parse_environment(entries) != expected_container_environment(manifest):
