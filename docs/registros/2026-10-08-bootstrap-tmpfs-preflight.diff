+"""Evidência kernel estrita para os tmpfs da prova; sem Docker/SQL."""
+PGDATA = '/var/lib/postgresql/data'
+SOCKET = '/var/run/postgresql'
+TMPFS = {
+    PGDATA: 'rw,nosuid,nodev,noexec,size=536870912,uid=105,gid=106,mode=0700',
+    SOCKET: 'rw,nosuid,nodev,noexec,size=16777216,uid=105,gid=106,mode=0770',
+}
+EXPECTED = {
+    PGDATA: ('size=524288k', 'mode=700'),
+    '/run/postgresql': ('size=16384k', 'mode=770'),
+}
+
+
+def parse_mountinfo(text):
+    records = {}
+    ids = set()
+    for line in text.splitlines():
+        fields = line.split()
+        try:
+            separator = fields.index('-')
+            if separator < 6 or len(fields) != separator + 4:
+                raise ValueError('mountinfo fields')
+            mount_id = int(fields[0]); int(fields[1])
+            path = fields[4]
+            if not path.startswith('/') or '\\' in path or '/..' in path:
+                raise ValueError('mountinfo path')
+            if path in records or mount_id in ids:
+                raise ValueError('duplicate mountinfo identity/path')
+            ids.add(mount_id)
+            records[path] = dict(root=fields[3], options=set(fields[5].split(',')),
+                                 type=fields[separator+1], source=fields[separator+2],
+                                 superOptions=set(fields[separator+3].split(',')))
+        except (ValueError, IndexError) as error:
+            raise ValueError('invalid mountinfo') from error
+    if not records:
+        raise ValueError('empty kernel mount evidence')
+    return records
+
+
+def validate_effective_tmpfs(metadata, text, resolved_paths, ownership):
+    host = metadata['HostConfig']
+    if host.get('Tmpfs') != TMPFS or host.get('Mounts') or host.get('Binds') or host.get('VolumesFrom'):
+        raise ValueError('exact tmpfs declaration without shared mounts required')
+    if resolved_paths != {PGDATA: PGDATA, SOCKET: '/run/postgresql'}:
+        raise ValueError('unexpected canonical data/socket paths')
+    if ownership != {PGDATA: '700:105:106', SOCKET: '770:105:106'}:
+        raise ValueError('effective data/socket permissions mismatch')
+    declared = metadata.get('Mounts', [])
+    if declared:
+        if len(declared) != 2 or {m.get('Destination') for m in declared} != set(TMPFS) \
+                or any(m.get('Type') != 'tmpfs' or m.get('Name') or m.get('Source') not in (None, '', 'tmpfs')
+                       or m.get('RW') is not True for m in declared):
+            raise ValueError('Docker effective mounts are not the exclusive tmpfs')
+    mounts = parse_mountinfo(text)
+    for path, (size, mode) in EXPECTED.items():
+        item = mounts.get(path)
+        if not item or item['root'] != '/' or item['type'] != 'tmpfs' or item['source'] != 'tmpfs' \
+                or item['options'] != {'rw', 'nosuid', 'nodev', 'noexec', 'relatime'} \
+                or item['superOptions'] != {'rw', size, mode, 'uid=105', 'gid=106'}:
+            raise ValueError('kernel tmpfs missing/divergent: ' + path)
+    root = mounts.get('/')
+    if not root or root['root'] != '/' or root['type'] != 'overlay' or root['source'] != 'overlay' \
+            or root['options'] != {'ro', 'relatime'}:
+        raise ValueError('root filesystem must be read-only overlay')
+    # Exact runtime system mounts; writable mounts outside this set fail closed.
+    system = {'/proc': ('proc', 'proc', '/'), '/dev': ('tmpfs', 'tmpfs', '/'),
+              '/dev/pts': ('devpts', 'devpts', '/'), '/dev/mqueue': ('mqueue', 'mqueue', '/'),
+              '/dev/shm': ('tmpfs', 'shm', '/')}
+    readonly_system = {'/sys': ('sysfs', 'sysfs'), '/sys/fs/cgroup': ('cgroup2', 'cgroup'),
+                       '/proc/bus': ('proc', 'proc'), '/proc/fs': ('proc', 'proc'),
+                       '/proc/irq': ('proc', 'proc'), '/proc/sys': ('proc', 'proc'),
+                       '/proc/sysrq-trigger': ('proc', 'proc'), '/proc/acpi': ('tmpfs', 'tmpfs'),
+                       '/proc/scsi': ('tmpfs', 'tmpfs'), '/sys/firmware': ('tmpfs', 'tmpfs')}
+    masked = {'/proc/interrupts', '/proc/kcore', '/proc/keys', '/proc/timer_list'}
+    for path, item in mounts.items():
+        if path in EXPECTED or path == '/':
+            continue
+        signature = (item['type'], item['source'], item['root'])
+        if path in system and signature == system[path]:
+            continue
+        if path in readonly_system and (item['type'], item['source']) == readonly_system[path] \
+                and 'ro' in item['options'] and 'rw' not in item['options']:
+            continue
+        if path in masked and signature == ('tmpfs', 'tmpfs', '/null'):
+            continue
+        if path in {'/etc/hosts', '/etc/hostname', '/etc/resolv.conf'} \
+                and item['root'] == '/data/docker/containers/' + metadata['Id'] + '/' + path.rsplit('/', 1)[-1] \
+                and item['type'] == 'ext4' and item['source'] == '/dev/sde' \
+                and item['options'] == {'ro', 'relatime'}:
+            continue
+        raise ValueError('unexpected kernel mount: ' + path)
+    # Derived only after both declarations AND kernel evidence have passed.
+    return [dict(Type='tmpfs', Destination=path, Source='tmpfs', RW=True) for path in TMPFS]
