+"""Mount evidence offline; no subprocess, Docker or SQL."""
+import copy
+from pathlib import Path
+import unittest
+from bootstrap_tmpfs_preflight import TMPFS, PGDATA, SOCKET, validate_effective_tmpfs
+
+CID = '8d76d3358c55a155f5824c7a65d2c28ab8afad600ddd8baa1d430896ae600402'
+# Minimal legitimate kernel set plus exact Docker declarations, no real environment access.
+EVIDENCE = '''1 0 0:1 / / ro,relatime - overlay overlay rw
+2 1 0:2 / /var/lib/postgresql/data rw,nosuid,nodev,noexec,relatime - tmpfs tmpfs rw,size=524288k,mode=700,uid=105,gid=106
+3 1 0:3 / /run/postgresql rw,nosuid,nodev,noexec,relatime - tmpfs tmpfs rw,size=16384k,mode=770,uid=105,gid=106
+'''
+
+
+class EffectiveTmpfs(unittest.TestCase):
+    def sample(self):
+        return {'Id': CID, 'HostConfig': {'Tmpfs': dict(TMPFS), 'Mounts': [], 'Binds': None,
+                                         'VolumesFrom': None}, 'Mounts': []}
+
+    def check(self, metadata=None, evidence=EVIDENCE, resolved=None, ownership=None):
+        return validate_effective_tmpfs(metadata or self.sample(), evidence,
+                                       resolved or {PGDATA: PGDATA, SOCKET: '/run/postgresql'},
+                                       ownership or {PGDATA: '700:105:106', SOCKET: '770:105:106'})
+
+    def test_exact_tmpfs_with_and_without_docker_mount_entries(self):
+        normalized = self.check()
+        self.assertEqual({m['Destination'] for m in normalized}, set(TMPFS))
+        metadata = self.sample(); metadata['Mounts'] = normalized
+        self.assertEqual(self.check(metadata), normalized)
+
+    def test_missing_and_changed_kernel_mounts_refused(self):
+        for evidence in ['', EVIDENCE.splitlines()[0], EVIDENCE.replace('tmpfs tmpfs', 'ext4 /dev/sda'),
+                         EVIDENCE.replace('size=524288k', 'size=524284k'),
+                         EVIDENCE.replace('mode=700', 'mode=777'), EVIDENCE.replace('uid=105', 'uid=0'),
+                         EVIDENCE.replace('rw,nosuid,nodev,noexec', 'rw,nosuid,nodev'),
+                         EVIDENCE.replace('/run/postgresql', '/unexpected'),
+                         EVIDENCE.replace('/ /var/lib/postgresql/data', '/resident /var/lib/postgresql/data'),
+                         EVIDENCE.replace('ro,relatime - overlay', 'rw,relatime - overlay'),
+                         EVIDENCE + EVIDENCE.splitlines()[1] + '\n']:
+            with self.subTest(evidence=evidence), self.assertRaises(ValueError):
+                self.check(evidence=evidence)
+
+    def test_declared_persistent_shared_unknown_mounts_refused(self):
+        for key, value in [('Tmpfs', {}), ('Mounts', [{'Type': 'bind'}]),
+                           ('Binds', ['/resident:/data']), ('VolumesFrom', ['resident'])]:
+            metadata = self.sample(); metadata['HostConfig'][key] = value
+            with self.assertRaises(ValueError):
+                self.check(metadata)
+        for entry in [{'Type': 'volume', 'Destination': PGDATA},
+                      {'Type': 'bind', 'Destination': PGDATA},
+                      {'Type': 'tmpfs', 'Destination': '/unexpected'}]:
+            metadata = self.sample(); metadata['Mounts'] = [entry]
+            with self.assertRaises(ValueError):
+                self.check(metadata)
+
+    def test_additional_kernel_mounts_and_resident_paths_refused(self):
+        for line in ['4 1 8:1 /resident /extra rw,relatime - ext4 /dev/sda rw',
+                     '4 1 0:4 / /extra rw,nosuid,nodev - tmpfs tmpfs rw',
+                     '4 1 8:1 /resident /etc/hosts rw,relatime - ext4 /dev/sde rw',
+                     '4 1 8:1 /resident /etc/hosts ro,relatime - ext4 /dev/sde rw',
+                     '4 1 0:4 / /sys rw,relatime - sysfs sysfs rw']:
+            with self.assertRaises(ValueError):
+                self.check(evidence=EVIDENCE + line + '\n')
+
+    def test_canonical_paths_permissions_and_config_options_refused(self):
+        with self.assertRaises(ValueError):
+            self.check(resolved={PGDATA: '/resident', SOCKET: '/run/postgresql'})
+        with self.assertRaises(ValueError):
+            self.check(ownership={PGDATA: '777:105:106', SOCKET: '770:105:106'})
+        metadata = self.sample(); metadata['HostConfig']['Tmpfs'][PGDATA] += ',exec'
+        with self.assertRaises(ValueError):
+            self.check(metadata)
+
+
+if __name__ == '__main__':
+    unittest.main()
