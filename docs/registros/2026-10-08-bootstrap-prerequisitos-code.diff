+"""Verifica somente arquivos/hashes/ordem do bootstrap. Sem rede, SQL ou Docker."""
+import hashlib
+import json
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+BOOTSTRAP = Path(__file__).resolve().parent
+MANIFEST = BOOTSTRAP / 'manifest.json'
+PHASE_ROLES = {'image-init': 'postgres', 'image-migration': 'supabase_admin',
+               'auth-v2.189.0': 'supabase_auth_admin', 'anima-migration': 'postgres'}
+PREREQUISITES = {1: ('roles-initial-prerequisite', 'postgres'),
+                 48: ('auth-transport-and-required-extensions', 'supabase_admin'),
+                 118: ('revoke-temporary-role-bridges', 'supabase_admin')}
+PATCHES = {'20260905000001_fix_budget_resume_request_correlation.sql',
+           '20260905000002_require_current_budget_block_for_human_resume.sql'}
+
+
+def sha256(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def verify(manifest_path=MANIFEST):
+    document = json.loads(Path(manifest_path).read_text())
+    history_path = ROOT / 'docs/registros/2026-10-08-bootstrap-247-inventory.json'
+    if sha256(history_path.read_bytes()) != document['historicalInventorySha256']:
+        raise ValueError('historical inventory drift')
+    for name, field in [('supabase/tests/bootstrap_plan.py', 'composerSha256'),
+                        ('supabase/tests/bootstrap_ledger.sql', 'ledgerSha256')]:
+        if sha256((ROOT/name).read_bytes()) != document[field]:
+            raise ValueError('prepared tool/ledger drift')
+    historical = json.loads(history_path.read_text())['entries']
+    entries = document['entries']
+    if len(entries) != 272 or [e['order'] for e in entries] != list(range(1, 273)):
+        raise ValueError('272 consecutive orders required')
+    if len({(e['phase'], e['name']) for e in entries}) != 272:
+        raise ValueError('duplicate identity')
+    phases = (['bootstrap'] + ['image-init']*5 + ['image-migration']*41 + ['bootstrap'] +
+              ['auth-v2.189.0']*69 + ['bootstrap'] + ['anima-migration']*154)
+    if [e['phase'] for e in entries] != phases:
+        raise ValueError('phase boundaries drift')
+    for entry, old in zip(entries, historical):
+        if any(entry[k] != old[k] for k in ('order', 'name', 'phase', 'role')):
+            raise ValueError('historical order/role identity drift')
+        if entry['historicalSourceSha256'] != old['sourceSha256']:
+            raise ValueError('historical hash drift')
+        if entry['phase'] == 'bootstrap':
+            if (entry['name'], entry['role']) != PREREQUISITES[entry['order']]:
+                raise ValueError('prerequisite order/role drift')
+        elif entry['role'] != PHASE_ROLES[entry['phase']]:
+            raise ValueError('phase role drift')
+        if not re.fullmatch('[a-f0-9]{64}', entry['sourceSha256']):
+            raise ValueError('source hash invalid')
+        path = ROOT / entry['source']
+        if not path.resolve().is_relative_to((BOOTSTRAP / 'sources').resolve()) or path.is_symlink():
+            raise ValueError('source must be frozen inside bootstrap')
+        if sha256(path.read_bytes()) != entry['sourceSha256']:
+            raise ValueError('source bytes/hash drift: ' + entry['name'])
+        if entry['sourceSha256'] != old['sourceSha256'] and entry['name'] not in PATCHES:
+            raise ValueError('unreviewed historical source difference')
+        if entry['phase'] == 'anima-migration' and sha256((ROOT/'supabase/migrations'/entry['name']).read_bytes()) != entry['sourceSha256']:
+            raise ValueError('local migration drift: ' + entry['name'])
+    for phase in PHASE_ROLES:
+        names = [e['name'] for e in entries if e['phase'] == phase]
+        if names != sorted(names):
+            raise ValueError('phase ordering not lexical')
+    provenance = json.loads((BOOTSTRAP/'sources/auth-v2.189.0/provenance.json').read_text())
+    if provenance['commit'] != document['authCommit'] or provenance['tag'] != 'v2.189.0' or provenance['files'] != 69:
+        raise ValueError('official auth provenance drift')
+    return entries
+
+
+def specification(run_id):
+    return dict(runId=run_id, steps=[{k: e[k] for k in ('source', 'phase', 'name', 'role', 'sourceSha256')} for e in verify()])
+
+
+def verify_prepared():
+    entries = verify()
+    spec = json.loads((BOOTSTRAP/'spec.json').read_text())
+    if spec != specification(spec['runId']):
+        raise ValueError('spec does not match frozen manifest')
+    rows = [json.loads(line) for line in (BOOTSTRAP/'prepared/plan.jsonl').read_text().splitlines()]
+    if len(rows) != 273 or any(r['status'] != 'prepared' or r['runId'] != spec['runId'] for r in rows[:-1]):
+        raise ValueError('prepared plan incomplete')
+    projected = []
+    for entry, row in zip(entries, rows[:-1]):
+        for key in ('order', 'phase', 'name', 'role', 'sourceSha256'):
+            if row[key] != entry[key]:
+                raise ValueError('prepared plan order/hash drift')
+        path = BOOTSTRAP/'prepared'/f"{entry['order']:03}.sql"
+        if sha256(path.read_bytes()) != row['payloadSha256']:
+            raise ValueError('payload bytes/hash drift')
+        projected.append({k: v for k, v in row.items() if k not in {'runId', 'status'}})
+    expected = dict(runId=spec['runId'], status='plan_complete', count=272,
+                    planSha256=sha256(json.dumps(projected, sort_keys=True).encode()))
+    if rows[-1] != expected:
+        raise ValueError('completeness marker mismatch')
+    return rows[-1]['planSha256']
+
+
+if __name__ == '__main__':
+    entries = verify()
+    plan_hash = verify_prepared()
+    print('PASS 272/272 source hashes and historical order; only 247/248 differ intentionally.')
+    print('Payload plan SHA-256:', plan_hash)
+    print('Static proof only; no PostgreSQL, Docker, ACL or isolation observed.')
