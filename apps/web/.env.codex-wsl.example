# Configuração PERSISTENTE do Codex via WSL para a CLI do ANIMA (npm run anima -- ...).
#
# Copie este arquivo para `apps/web/.env.codex-wsl.local` (ignorado pelo Git) e ajuste para esta máquina.
# É carregado SÓ pelo script `anima` (não pelo Next nem pelo resident host). Sem segredos: o Codex Linux usa a
# assinatura do usuário Linux; nunca coloque chaves de API, tokens ou senhas aqui.
#
# Precedência: variável já definida no ambiente do processo > .env.codex-wsl.local > .env.local.
# ANIMA_CODEX_CLI_PATH NÃO pode coexistir com o transporte WSL (conflito é recusado).
# Verifique com: npm run anima -- work executors <UUID>   (bloco "Codex CLI": transporte, distro, usuário, binário, versão)

ANIMA_CODEX_CLI_TRANSPORT=wsl
ANIMA_CODEX_WSL_DISTRO=Ubuntu-24.04
ANIMA_CODEX_WSL_USER=geanteco
ANIMA_CODEX_WSL_CLI_PATH=/home/geanteco/.nvm/versions/node/v22.23.3/bin/codex
