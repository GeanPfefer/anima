# ============================================================
# Anima — catálogo operacional de configuração do apps/web (CLI, Resident Host, Next).
# Copie para apps/web/.env.local e preencha. NUNCA commite o .env.local.
#
# Contrato completo (classes, origem, reprovisionamento, grupos de prontidão):
#   apps/web/lib/recovery-config/manifest.ts
# Verificação read-only (não imprime valores, não usa rede):
#   npm run anima --workspace=@anima/web -- recovery-config check
#
# Convenções deste arquivo:
#   - segredo            → `CHAVE=` vazio (preencha a partir do seu cofre; nunca invente valor)
#   - <PLACEHOLDER>      → valor específico da sua máquina/instalação; o checker recusa o placeholder
#   - linha comentada    → opcional; o código tem default seguro
#   - valores com `#`    → coloque entre aspas no .env.local
# Chaves legadas/deprecated NÃO aparecem aqui (ver o manifesto).
# ============================================================

# ---------- Core Supabase (grupo: core) ----------
# Derivável de `supabase status` no stack local restaurado (API URL e anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY_FROM_SUPABASE_STATUS>

# ---------- Resident identity (grupos: resident, self-development) ----------
# Identificador pessoal da identidade restaurada (não é segredo, mas é dado pessoal).
ANIMA_RESIDENT_EMAIL=<RESIDENT_IDENTITY_EMAIL>
# Segredo. Em máquina nova: redefina a credencial da identidade restaurada.
ANIMA_RESIDENT_PASSWORD=
# Superfície de desenvolvimento do chat: UUIDs (vírgula) da identidade RESTAURADA.
# Rederive de auth.users; não copie cegamente um UUID de outra instalação.
# Vazio = ninguém tem acesso de desenvolvimento.
ANIMA_DEVELOPMENT_CHAT_USER_IDS=

# ---------- AI provider (grupos: chat-openai, local-ai) ----------
# Chat principal: openai | ollama (default openai). Com ollama, a chave OpenAI não é exigida.
ANIMA_AI_PROVIDER=openai
# Segredo server-side; exigido só quando o chat ou o coder usam OpenAI.
OPENAI_API_KEY=
# OPENAI_MODEL=                       # default do código

# ---------- Local / Ollama (grupo: local-ai) ----------
# Defaults do código: http://localhost:11434 e os modelos padrão. Declare só se diferir.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=
# OLLAMA_EMBED_MODEL=

# ---------- Self-development / worktree / coder (grupo: self-development) ----------
# Coder do executor de worktree: ollama (default) | openai (exige OPENAI_API_KEY).
ANIMA_CODER_PROVIDER=ollama
# ANIMA_CODER_MODEL=
# ANIMA_WORKTREE_CODER_MODEL=
# Raiz do repositório: derivada do cwd. Declare só para processos fora da árvore.
# ANIMA_PROJECT_ROOT=<ABSOLUTE_PATH_TO_ANIMA_REPO>
# Fallback governado de coder (ausente ⇒ desligado).
# ANIMA_CODER_VRAM_GB=
# ANIMA_CODER_MODEL_ALLOWLIST=
# Runner local (INT-04): opcional; ausente ⇒ rota do runner local indisponível.
# ANIMA_LOCAL_RUNNER_ROOT=<ABSOLUTE_PATH_TO_ANIMA_REPO>/tools/local-agent
# ANIMA_LOCAL_TARGETS_JSON={"anima":"<ABSOLUTE_PATH_TO_ANIMA_REPO>"}
# ANIMA_LOCAL_RUNNER_MODEL=
# Override do catálogo de pricing (ausente ⇒ catálogo versionado no repo).
# ANIMA_PROVIDER_PRICING_CATALOG=<ABSOLUTE_PATH_TO_PRICING_JSON>

# ---------- Resident Host (grupo: resident) ----------
# Kill switch de autonomia (decisão humana).
# ANIMA_AUTONOMY_ENABLED=
# ANIMA_RESIDENT_TRANSPORT=in_process      # in_process (default) | http
# ANIMA_RESIDENT_ROUTE_BASE=http://localhost:3000
# ANIMA_SUPERVISOR_INSTANCE_ID=supervisor-v0
# ANIMA_RESIDENT_LOG_FILE=<ABSOLUTE_PATH_TO_LOG_FILE>

# ---------- Router (grupo: self-development) ----------
# Compute Router V1: 1 liga; ausente ⇒ OFF e invisível.
# ANIMA_COMPUTE_ROUTER_V1_ENABLED=1

# ---------- RunPod / SSH (grupo: runpod; só avaliado com ANIMA_ON_DEMAND_NODE_ENABLED=true) ----------
# Compute PAGO: toda execução continua exigindo authority humana por work item.
# ANIMA_ON_DEMAND_NODE_ENABLED=true
# ANIMA_ON_DEMAND_NODE_PROVISIONER=runpod
# ANIMA_ON_DEMAND_NODE_ID=<NODE_SLUG>
# ANIMA_ON_DEMAND_NODE_BILLING_MODE=paid
# ANIMA_ON_DEMAND_PRICE_PER_HOUR=
# ANIMA_RUNPOD_API_KEY=
# ANIMA_RUNPOD_IMAGE=<RUNPOD_IMAGE>
# ANIMA_RUNPOD_GPU_TYPE_IDS=<GPU_TYPE_ID_LIST>
# Par SSH DEDICADO ao RunPod (gere um novo em máquina nova; a chave privada é segredo).
# ANIMA_RUNPOD_SSH_PRIVATE_KEY=<ABSOLUTE_PATH_TO_DEDICATED_PRIVATE_KEY>
# ANIMA_RUNPOD_SSH_PUBLIC_KEY=
# ANIMA_RUNPOD_SSH_KNOWN_HOSTS=<ABSOLUTE_PATH_TO_DEDICATED_KNOWN_HOSTS>

# ---------- Research Web (grupo: research-web; ausente ⇒ indisponível, core não é afetado) ----------
# ANIMA_RESEARCH_SEARXNG_URL=http://127.0.0.1:<SEARXNG_PORT>
# ANIMA_RESEARCH_AGENT_BROWSER_BIN=<ABSOLUTE_PATH_TO_AGENT_BROWSER_BIN>

# ---------- Mobile / network ----------
# As chaves do app ficam em apps/mobile/.env.local (ver apps/mobile/.env.example).
# Use um endereço alcançável pelo telefone (ex.: nome/IP da sua rede privada), nunca um IP real commitado.

# ---------- Integration GitHub (grupo: github-integration) ----------
# ANIMA_INTEGRATION_REPOSITORY_ID=<CANONICAL_REMOTE_URL>
# ANIMA_INTEGRATION_REMOTE_NAME=origin
# ANIMA_INTEGRATION_BASE_BRANCH=main
# ANIMA_INTEGRATION_GITHUB_TOKEN=

# ---------- Tuning avançado (defaults do código; declare só com motivo) ----------
# ANIMA_OPENAI_CODER_REASONING_EFFORT=
# ANIMA_OPENAI_CODER_TIMEOUT_MS=
# ANIMA_OPENAI_CODER_OUTPUT_TOKENS=
# ANIMA_PROJECT_PLANNER_PROVIDER=
# ANIMA_RESIDENT_IDLE_MS=
# ANIMA_RUNPOD_MAX_PROVISION_MS=
