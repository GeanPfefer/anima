NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
OLLAMA_URL=http://100.68.239.78:11434
OLLAMA_MODEL=qwen2.5:14b

# Chat principal: "openai" ou "ollama". A interface permite trocar por mensagem.
ANIMA_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Superfície de desenvolvimento do chat (fronteira de produto). O chat padrão é
# uma conversa PESSOAL: nunca recebe ferramentas de repositório. As ferramentas
# de leitura do código só são habilitadas quando DUAS condições coincidem — o
# pedido traz developmentMode=true E o id do usuário está nesta lista (separada
# por vírgulas). Vazio por padrão: ninguém tem acesso de desenvolvimento.
ANIMA_DEVELOPMENT_CHAT_USER_IDS=

ANIMA_PROJECT_ROOT=G:\anima
ANIMA_LOCAL_RUNNER_ROOT=G:\anima\tools\local-agent
ANIMA_LOCAL_RUNNER_MODEL=qwen3-coder:30b
ANIMA_LOCAL_TARGETS_JSON={"anima":"G:\\anima"}
